{
  "manifest_version": 3,
  "name": "LyricSnap 自動モード",
  "version": "1.0.0",
  "description": "YouTubeで再生中の曲を自動検出し、サイドパネルに歌詞を自動表示・自動スクロールします。",
  "permissions": ["sidePanel", "tabs"],
  "host_permissions": ["*://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LyricSnap を開く"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
